{
    "plugins": [
        "frontmatter",
        "preset-lint-consistent",
        "preset-lint-recommended",
        "preset-lint-markdown-style-guide",
        "preset-prettier",
        ["lint-no-duplicate-headings", false],
        ["lint-no-file-name-irregular-characters", "-_.0-9A-Za-z"],
        ["lint-no-undefined-references", { "allowShortcutLink": true }]
    ]
}
